# ── Copy this to .env and fill in all values ──────────────────────────────────
# cp .env.example .env

# ── Django ────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-long-random-string

DEBUG=False

# Your server IP or domain — comma-separated, no spaces
ALLOWED_HOSTS=localhost,127.0.0.1

# Full URL where students access the app (needed for CORS)
CORS_ALLOWED_ORIGINS=http://localhost

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=learnforge
DB_USER=learnforge_user
DB_PASSWORD=choose_a_strong_password_here
# DB_HOST is set automatically by docker-compose → do not set here

# ── Celery / Redis ────────────────────────────────────────────────────────────
# Set automatically by docker-compose → do not change for local use
CELERY_BROKER_URL=redis://redis:6379/0

# ── FFmpeg ────────────────────────────────────────────────────────────────────
# Empty = uses /usr/bin/ffmpeg installed inside the container
FFMPEG_PATH=
HLS_SEGMENT_SECONDS=60
FFMPEG_PRESET=ultrafast

# ── Web ───────────────────────────────────────────────────────────────────────
# Host port Nginx listens on. Change to 8080 if port 80 is in use.
WEB_PORT=80
